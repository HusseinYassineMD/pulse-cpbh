APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./pulse.db
JWT_SECRET_KEY=dev-secret-change-in-production

# Pulse local ports (see start.sh)
# Local dev: keep API_URL on localhost (start.sh overrides tunnel URLs automatically)
API_URL=http://127.0.0.1:8010
WEB_URL=http://localhost:3010
# Optional — only needed for SSR; browser uses /api proxy in dev
NEXT_PUBLIC_API_URL=http://127.0.0.1:8010
# GitHub Pages build only — link preview site Submit page to hosted app (no trailing slash)
NEXT_PUBLIC_HOSTED_APP_URL=
# Set to true to restore full nav (Create, Plan, Board, command bar, etc.)
NEXT_PUBLIC_FULL_UI=

POST_CREATOR_PATH=../Post_Creator

# Keep true until you're ready for a real publish
PUBLISH_DRY_RUN=true

# Public HTTPS URL for publish (Meta must fetch images). Example: https://abc123.ngrok-free.app
PUBLISH_API_URL=

# Secret key appended to public media URLs so Instagram can fetch images
MEDIA_PUBLISH_KEY=dev-media-key-change-me

AUTH_ENABLED=false

# Plan — team roster for assignee picker (Name:email,Name:email). Use your real roster in local .env only.
PLAN_TEAM=Team Lead:lead@example.com,Editor:editor@example.com

# Student submit — lead (Tiffany) gets “new draft” + 12h reminders until approve (falls back to first PLAN_TEAM email)
REVIEW_LEAD_EMAIL=
REVIEW_REMINDER_HOURS=12

# Email — Resend is easiest (resend.com → API Keys). Without this, Pulse opens Outlook compose.
RESEND_API_KEY=
RESEND_FROM=Pulse CPBH <onboarding@resend.dev>

# SMTP — optional fallback; USC Microsoft 365 often blocks basic SMTP auth
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Meta — create app at developers.facebook.com, add Instagram Graph + Facebook Login
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://127.0.0.1:8010/api/v1/oauth/meta/callback

# LinkedIn — create app at developer.linkedin.com, request Community Management API
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8010/api/v1/oauth/linkedin/callback

# Optional — paste tokens from Graph API Explorer / LinkedIn app (never commit real values)
# INSTAGRAM_ACCOUNT_ID=
# INSTAGRAM_ACCESS_TOKEN=
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=
# LINKEDIN_ORG_ID=
# LINKEDIN_ACCESS_TOKEN=
